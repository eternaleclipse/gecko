# Maintainer: Gecko contributors <gecko@users.noreply.github.com>
# AUR package: Gecko from the release tarball (prebuilt gecko and its
# Electron window). The source build is the "gecko" package.
pkgname=gecko-bin
pkgver=0.3.3
pkgrel=1
pkgdesc="Terminal multiplexer for coding agents across your machines (CLI, daemon and native window)"
arch=('x86_64' 'aarch64')
url="https://github.com/eternaleclipse/gecko"
# The project has not chosen a license yet (docs/linux-packages.md).
license=('LicenseRef-Unspecified')
depends=('gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'libnotify' 'at-spi2-core' 'libsecret' 'mesa' 'libdrm' 'libxkbcommon' 'xdg-utils'
         'dbus' 'libxrandr' 'cairo' 'hicolor-icon-theme')
optdepends=('tmux: tmux sessions in Gecko'
            'mosh: mosh connections to other machines')
provides=('gecko')
conflicts=('gecko')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/gecko-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/gecko-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "gecko-$pkgver-linux-$CARCH"
  cp -a usr "$pkgdir/"
  # Chromium's setuid sandbox helper, used where user namespaces are off.
  chmod 4755 "$pkgdir/usr/lib/gecko-desktop/chrome-sandbox"
  install -Dm644 usr/lib/gecko-desktop/LICENSE.electron.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.electron.txt"
}
